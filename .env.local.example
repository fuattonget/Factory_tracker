# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local (it's gitignored by default in this project).
# This project reuses dash_app's existing Supabase project — see
# PROJECT_PLAN.md section 2 for why. Get the real values from dash_app's
# own .env, or the Supabase dashboard (Project Settings > API).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public anon key, only for Supabase Auth in the browser (admin login) --
# never used for data queries, see PROJECT_PLAN.md section 3.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
